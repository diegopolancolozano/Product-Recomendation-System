# ============================================================
#  Variables de entorno — Supermarket Analytics
#  Copiar a .env y completar los valores reales.
#  NUNCA subir .env al repositorio.
# ============================================================

# ── Backend FastAPI ──────────────────────────────────────────
# Ruta al directorio DataSet/DataSet (absoluta o relativa a la raíz del proyecto)
# En local: dejar vacío (usa el default ./DataSet/DataSet)
# En Cloud Run: no necesario si el dataset va embebido en la imagen
DATA_DIR=

# ── Frontend Next.js ─────────────────────────────────────────
# URL del backend que el NAVEGADOR llama directamente.
# En local: http://localhost:8000
# En Cloud Run: https://<cloud-run-api-url>  (sin trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Google Cloud (solo para despliegue en GCP) ───────────────
GCP_PROJECT_ID=CHANGE_ME
GCP_REGION=us-central1
GCS_BUCKET=CHANGE_ME-supermarket-data
ARTIFACT_REGISTRY_REPO=supermarket-analytics
